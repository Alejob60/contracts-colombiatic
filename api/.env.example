# ─── ColombiaTIC Contracts API — Environment Variables ────────────────
# Copy to .env and fill in real values. Never commit .env to git.

# ── Application ──────────────────────────────────────────────────────────
APP_NAME=contracts-api
APP_ENV=development                 # development | staging | production
LOG_LEVEL=INFO

# ── Database (PostgreSQL, schema=contracts) ──────────────────────────────
# The options param sets the search_path so all tables live in "contracts"
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/colombiatic?options=-c%20search_path%3Dcontracts

# ── Redis (DB 2 — avoid collision with GovDocs/Atelier) ─────────────────
REDIS_URL=redis://127.0.0.1:6379/2

# ── JWT (shared with Atelier backend realculture) ────────────────────────
JWT_SECRET=CHANGE-ME-in-production
JWT_ALGORITHM=HS256

# ── AWS / Bedrock ────────────────────────────────────────────────────────
AWS_REGION=us-east-1
BEDROCK_MODEL_EVALUATOR=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MODEL_EMBED=amazon.titan-embed-text-v2:0

# ── SECOP II (Datos Abiertos / Socrata) ──────────────────────────────────
SECOP_API_URL=https://www.datos.gov.co/resource/p6dx-8zbt.json
SECOP_APP_TOKEN=                    # optional Socrata app token for higher rate limits
SECOP_CACHE_TTL_SEARCH=900          # 15 min
SECOP_CACHE_TTL_DETAIL=21600        # 6 h

# ── S3 Document Storage ─────────────────────────────────────────────────
S3_BUCKET_DOCUMENTS=contracts-documents
S3_REGION=us-east-1

# ── Freemium Rate Limiting ───────────────────────────────────────────────
FREEMIUM_MAX_SEARCHES=3             # searches per rolling window (free tier)
FREEMIUM_COUNTER_TTL=86400          # 24 h in seconds
