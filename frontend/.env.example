# ──────────────────────────────────────────────────────────────────────────
# ColombiaTIC Contracts — Frontend Environment Variables
# Copy to .env.local and fill in the values.
# ──────────────────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3301

# Site URL for OG tags and canonical links
NEXT_PUBLIC_SITE_URL=https://contracts.colombiatic.com.co

# Wompi public key (checkout widget)
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_XXXXXXXXXXXXXXXX

# Wompi integrity key (server-side signature verification)
WOMPI_INTEGRITY_KEY=test_integrity_XXXXXXXXXXXXXXXX

# Wompi events webhook secret
WOMPI_EVENTS_KEY=events_test_XXXXXXXXXXXXXXXX

# JWT secret for token validation in middleware (Sprint 2)
JWT_SECRET=change-me-in-production

# Google OAuth client ID (Sprint 2)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# WhatsApp Business API (Sprint 3 — alerts)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
